generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Guild {
  id        String    @id // Discord snowflake ID
  name      String
  icon      String?
  channels  Channel[]
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Channel {
  id        String    @id // Discord snowflake ID
  guildId   String?   // null for DM channels
  guild     Guild?    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name      String
  type      Int // Discord channel type
  position  Int?
  parentId  String? // Parent channel ID (for threads and forum posts)
  archived  Boolean   @default(false)
  locked    Boolean   @default(false)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([guildId])
  @@index([parentId])
}

model Message {
  id             String       @id // Discord snowflake ID
  channelId      String
  channel        Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  guildId        String?      // null for DMs
  guild          Guild?       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  authorId       String
  authorUsername String
  authorDisplayName String?   // サーバーニックネーム
  authorBot      Boolean      @default(false)
  content        String
  timestamp      DateTime // Discord message timestamp
  attachments    Attachment[]
  reactions      Reaction[]
  embeds         String // Store embeds as JSON string (SQLite doesn't support Json[])
  hasLink        Boolean      @default(false)
  hasAttachment  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([channelId])
  @@index([guildId])
  @@index([authorId])
  @@index([timestamp])
}

model Attachment {
  id            String   @id @default(uuid())
  messageId     String
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename      String
  url           String
  size          Int?
  contentType   String?
  parsedContent String?  // Gemini解析結果（画像の説明テキスト等）
  createdAt     DateTime @default(now())

  @@index([messageId])
  @@index([url])
}

model Reaction {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji     String  // Unicode絵文字またはカスタム絵文字名
  count     Int

  @@unique([messageId, emoji])
  @@index([messageId])
}

// ============================================================
// エージェントライフサイクル管理
// ============================================================

model AgentState {
  id             String   @id @default("singleton")
  mode           String   // "OFF" | "AWAKE_NOT_WATCHING" | "AWAKE_WATCHING"
  focusChannelId String?
  lastWakeAt     DateTime?
  lastSleepAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LifecycleConfig {
  id                      String   @id @default("singleton")
  sleepStartTime          String   // "HH:MM" format
  sleepEndTime            String   // "HH:MM" format
  promotionMeanIntervalMs Int
  activityTickIntervalMs  Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model ChannelReadState {
  channelId         String   @id
  guildId           String
  lastReadMessageId String?
  unreadCount       Int      @default(0) // Deprecated: Use UnreadMessage table instead
  updatedAt         DateTime @updatedAt

  @@index([guildId])
}

model UnreadMessage {
  id        String   @id @default(uuid())
  channelId String
  guildId   String
  messageId String
  createdAt DateTime @default(now())

  @@unique([channelId, messageId])
  @@index([channelId])
  @@index([createdAt])
}

// ============================================================
// 汎用スケジューラー
// ============================================================

model ScheduledJob {
  id           String    @id @default(uuid())
  name         String    // ジョブ名（system:activity_tick, reminder:xxx など）
  scheduleType String    // "once" | "interval" | "cron" | "exponential"
  scheduleData String    // JSON: スケジュール設定
  payloadType  String    // "reminder" | "activity_tick" | "promotion_tick"
  payloadData  String    // JSON: ペイロードデータ
  enabled      Boolean   @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([payloadType])
}

// ============================================================
// セキュリティ / プロンプトインジェクション対策
// ============================================================

// 本人 (owner) 設定の永続化。env NOTIFY_TARGET_USER_ID から起動時に upsert される。
model OwnerConfig {
  id          String   @id @default("singleton")
  ownerUserId String                 // Discord User ID (snowflake)
  dmChannelId String?                // resolve 済み DMChannel ID（キャッシュ）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 命令解釈を許可する信頼ユーザー。HER-74 で manage_trust から CRUD される。
model TrustedUser {
  userId  String   @id              // Discord User ID
  addedAt DateTime @default(now())
  addedBy String?                    // 追加経路: "env" | "owner" | "<userId>"
  note    String?
}

// 信頼追加の承認待ちリクエスト。HER-74 の DM ボタン承認用。
model PendingTrustRequest {
  id          String    @id @default(cuid())
  userIds     String                 // JSON 配列（複数 userId を 1 リクエストに束ねる）
  reason      String
  requestedBy String                 // リクエスト元 bot 名
  dmMessageId String?                // 承認 DM のメッセージ ID
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?                // "approved" | "denied" | "expired"

  @@index([resolvedAt])
}

// notify_owner で送信した通知の履歴。
model Notification {
  id          String   @id @default(cuid())
  severity    String                 // "info" | "warn" | "threat"
  category    String?                // 用途分類（self_edit / injection_suspect / general など）
  message     String                 // 通知本文
  sentAt      DateTime @default(now())
  dmMessageId String?                // 送信した DM メッセージ ID（分割時は最初の ID）

  @@index([sentAt])
  @@index([severity])
}
